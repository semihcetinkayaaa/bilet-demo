# ops-mcp ayarları. Bu dosyayı .env olarak kopyalayın; .env Git'e yüklenmez.

# MCP istemcilerinin göndereceği gizli anahtar (en az 32 karakter). Üretmek için (PowerShell):
#   [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
MCP_TOKEN=

# Salt okunur veritabanı. Canlıda: grafana_ro kullanıcısıyla bilet veritabanı (iç ağ adresi).
# Yerelde test için SSH tüneli + bilet_dev kullanılabilir.
DATABASE_URL=postgresql://KULLANICI:SIFRE@localhost:5433/bilet_dev

# İç ağ adresleri (canlıda Coolify 'coolify' ağı üzerinden)
PROMETHEUS_URL=
GRAFANA_URL=
# Grafana'da Viewer rolünde service account token'ı (alarmları okumak için)
GRAFANA_TOKEN=
BACKEND_URL=https://bilet-api.semihcetinkaya.tech

# Kabul edilen Host başlıkları (virgülle ayrılmış)
ALLOWED_HOSTS=ops-mcp.semihcetinkaya.tech,localhost:*,127.0.0.1:*

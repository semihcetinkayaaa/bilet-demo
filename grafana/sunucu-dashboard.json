        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "node_load5{job=\"node\"}",
          "legendFormat": "5 dk",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "node_load15{job=\"node\"}",
          "legendFormat": "15 dk",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "scalar(count(node_cpu_seconds_total{job=\"node\", mode=\"idle\"}))",
          "legendFormat": "Çekirdek sayısı",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Çekirdek sayısı"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Disk okuma / yazma",
      "description": "Yazma aşağı yönde gösterilir.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(rate(node_disk_read_bytes_total{job=\"node\", device!~\"loop.*|ram.*\"}[$__rate_interval]))",
          "legendFormat": "Okuma",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "-sum(rate(node_disk_written_bytes_total{job=\"node\", device!~\"loop.*|ram.*\"}[$__rate_interval]))",
          "legendFormat": "Yazma",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"

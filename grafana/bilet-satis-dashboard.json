  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ciro",
      "description": "Seçili zaman aralığında ödenmiş siparişlerin toplam tutarı.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_BILET}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_BILET}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS \"Ciro\"\n\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.id\nJOIN ticket_types tt ON tt.id = oi.ticket_type_id\nJOIN events e ON e.id = tt.event_id\nJOIN venues v ON v.id = e.venue_id\nWHERE o.status = 'paid' AND ('$demo' = 'dahil' OR o.buyer_email NOT LIKE '%@example.com') AND $__timeFilter(o.paid_at) AND e.category IN ($kategori) AND v.city IN ($sehir)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyTRY",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Satılan bilet",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_BILET}"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_BILET}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(oi.quantity), 0) AS \"Bilet\"\n\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.id\nJOIN ticket_types tt ON tt.id = oi.ticket_type_id\nJOIN events e ON e.id = tt.event_id\nJOIN venues v ON v.id = e.venue_id\nWHERE o.status = 'paid' AND ('$demo' = 'dahil' OR o.buyer_email NOT LIKE '%@example.com') AND $__timeFilter(o.paid_at) AND e.category IN ($kategori) AND v.city IN ($sehir)"
        }
      ],

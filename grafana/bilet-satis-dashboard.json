    {
      "id": 7,
      "type": "timeseries",
      "title": "Günlük ciro",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_BILET}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_BILET}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(o.paid_at, 1d), SUM(oi.quantity * oi.unit_price) AS \"Ciro\"\n\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.id\nJOIN ticket_types tt ON tt.id = oi.ticket_type_id\nJOIN events e ON e.id = tt.event_id\nJOIN venues v ON v.id = e.venue_id\nWHERE o.status = 'paid' AND ('$demo' = 'dahil' OR o.buyer_email NOT LIKE '%@example.com') AND $__timeFilter(o.paid_at) AND e.category IN ($kategori) AND v.city IN ($sehir)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyTRY",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "barAlignment": 0,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Kategoriye göre ciro",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_BILET}"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_BILET}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE e.category WHEN 'concert' THEN 'Konser' WHEN 'match' THEN 'Maç'\n  WHEN 'cinema' THEN 'Sinema' WHEN 'theater' THEN 'Tiyatro' END AS \"Kategori\", SUM(oi.quantity * oi.unit_price) AS \"Ciro\"\n\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.id\nJOIN ticket_types tt ON tt.id = oi.ticket_type_id\nJOIN events e ON e.id = tt.event_id\nJOIN venues v ON v.id = e.venue_id\nWHERE o.status = 'paid' AND ('$demo' = 'dahil' OR o.buyer_email NOT LIKE '%@example.com') AND $__timeFilter(o.paid_at) AND e.category IN ($kategori) AND v.city IN ($sehir)\nGROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyTRY"
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "displayLabels": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Günlük satılan bilet (kategoriye göre)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_BILET}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_BILET}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(o.paid_at, 1d), CASE e.category WHEN 'concert' THEN 'Konser' WHEN 'match' THEN 'Maç'\n  WHEN 'cinema' THEN 'Sinema' WHEN 'theater' THEN 'Tiyatro' END AS metric, SUM(oi.quantity) AS value\n\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.id\nJOIN ticket_types tt ON tt.id = oi.ticket_type_id\nJOIN events e ON e.id = tt.event_id\nJOIN venues v ON v.id = e.venue_id\nWHERE o.status = 'paid' AND ('$demo' = 'dahil' OR o.buyer_email NOT LIKE '%@example.com') AND $__timeFilter(o.paid_at) AND e.category IN ($kategori) AND v.city IN ($sehir)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {

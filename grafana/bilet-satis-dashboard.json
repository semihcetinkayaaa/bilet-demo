    {
      "id": 4,
      "type": "stat",
      "title": "Ortalama sepet",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_BILET}"
      },
      "gridPos": {
        "x": 13,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_BILET}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(oi.quantity * oi.unit_price) / NULLIF(COUNT(DISTINCT o.id), 0), 0) AS \"Ortalama\"\n\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.id\nJOIN ticket_types tt ON tt.id = oi.ticket_type_id\nJOIN events e ON e.id = tt.event_id\nJOIN venues v ON v.id = e.venue_id\nWHERE o.status = 'paid' AND ('$demo' = 'dahil' OR o.buyer_email NOT LIKE '%@example.com') AND $__timeFilter(o.paid_at) AND e.category IN ($kategori) AND v.city IN ($sehir)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyTRY",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Ödeme başarı oranı",
      "description": "Ödenen / (ödenen + reddedilen). Bekleyen ve iptal edilenler hariç.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_BILET}"
      },
      "gridPos": {
        "x": 17,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_BILET}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(\n  COUNT(DISTINCT o.id) FILTER (WHERE o.status = 'paid')::float\n  / NULLIF(COUNT(DISTINCT o.id) FILTER (WHERE o.status IN ('paid', 'failed')), 0), 0) AS \"Başarı\"\n\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.id\nJOIN ticket_types tt ON tt.id = oi.ticket_type_id\nJOIN events e ON e.id = tt.event_id\nJOIN venues v ON v.id = e.venue_id\nWHERE ('$demo' = 'dahil' OR o.buyer_email NOT LIKE '%@example.com') AND $__timeFilter(o.created_at) AND e.category IN ($kategori) AND v.city IN ($sehir)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "teal"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {

          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Şehirlere göre ciro",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_BILET}"
      },
      "gridPos": {
        "x": 14,
        "y": 13,

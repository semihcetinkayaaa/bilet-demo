          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lpad(extract(hour FROM o.created_at AT TIME ZONE 'Europe/Istanbul')::text, 2, '0') || ':00' AS \"Saat\",\n       COUNT(DISTINCT o.id) AS \"Sipariş\"\n\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.id\nJOIN ticket_types tt ON tt.id = oi.ticket_type_id\nJOIN events e ON e.id = tt.event_id\nJOIN venues v ON v.id = e.venue_id\nWHERE ('$demo' = 'dahil' OR o.buyer_email NOT LIKE '%@example.com') AND $__timeFilter(o.created_at) AND e.category IN ($kategori) AND v.city IN ($sehir)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }

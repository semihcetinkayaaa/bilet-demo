          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT v.city AS \"Şehir\", SUM(oi.quantity * oi.unit_price) AS \"Ciro\"\n\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.id\nJOIN ticket_types tt ON tt.id = oi.ticket_type_id\nJOIN events e ON e.id = tt.event_id\nJOIN venues v ON v.id = e.venue_id\nWHERE o.status = 'paid' AND ('$demo' = 'dahil' OR o.buyer_email NOT LIKE '%@example.com') AND $__timeFilter(o.paid_at) AND e.category IN ($kategori) AND v.city IN ($sehir)\nGROUP BY 1 ORDER BY 2 DESC"
        }

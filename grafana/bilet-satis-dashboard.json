    {
      "id": 11,
      "type": "bargauge",
      "title": "En çok ciro getiren 10 etkinlik",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_BILET}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_BILET}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.title || ' · ' || v.city || ' · ' || to_char(e.starts_at AT TIME ZONE 'Europe/Istanbul', 'DD.MM HH24:MI') AS \"Etkinlik\",\n       SUM(oi.quantity * oi.unit_price) AS \"Ciro\"\n\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.id\nJOIN ticket_types tt ON tt.id = oi.ticket_type_id\nJOIN events e ON e.id = tt.event_id\nJOIN venues v ON v.id = e.venue_id\nWHERE o.status = 'paid' AND ('$demo' = 'dahil' OR o.buyer_email NOT LIKE '%@example.com') AND $__timeFilter(o.paid_at) AND e.category IN ($kategori) AND v.city IN ($sehir)\nGROUP BY e.id, e.title, v.city, e.starts_at ORDER BY 2 DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyTRY",
          "color": {
            "mode": "continuous-BlPu"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "valueMode": "color",
        "namePlacement": "top"
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Yaklaşan etkinliklerde doluluk",
      "description": "Satılan adetler tüm zamanlar içindir (zaman aralığından bağımsız; demo siparişler dahil).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_BILET}"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_BILET}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.title AS \"Etkinlik\", CASE e.category WHEN 'concert' THEN 'Konser' WHEN 'match' THEN 'Maç'\n  WHEN 'cinema' THEN 'Sinema' WHEN 'theater' THEN 'Tiyatro' END AS \"Kategori\", v.city AS \"Şehir\",\n       e.starts_at AS \"Tarih\",\n       SUM(tt.sold) AS \"Satılan\", SUM(tt.quota) AS \"Kontenjan\",\n       SUM(tt.sold)::float / NULLIF(SUM(tt.quota), 0) AS \"Doluluk\"\nFROM events e\nJOIN venues v ON v.id = e.venue_id\nJOIN ticket_types tt ON tt.event_id = e.id\nWHERE e.starts_at >= now() AND e.category IN ($kategori) AND v.city IN ($sehir)\nGROUP BY e.id, e.title, e.category, v.city, e.starts_at\nORDER BY \"Doluluk\" DESC, e.starts_at\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Doluluk"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tarih"

# Bu dosyayı .env adıyla kopyalayıp gerçek değerleri yazın.
# .env dosyası Git'e yüklenmez, şifreler orada güvende kalır.

# Yerel geliştirme: SSH tüneli açıkken sunucudaki bilet_dev veritabanına bağlanır.
# Coolify'ın verdiği "postgres://..." biçimi de kabul edilir.
DATABASE_URL=postgresql+psycopg://KULLANICI:SIFRE@localhost:5433/bilet_dev

# Frontend adresleri (virgülle ayrılmış)
CORS_ORIGINS=http://localhost:3000
# E-postadaki bağlantılar için sitenin adresi
SITE_URL=http://localhost:3000

# E-posta (isteğe bağlı). SMTP_HOST boşsa e-posta gönderilmez, sadece loglanır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Alarm deneme uçları (/test/alarm/...). Boş bırakılırsa kapalıdır.
# Açmak için en az 32 karakterlik rastgele bir anahtar yazın; isteklerde X-Test-Key başlığıyla gönderilir.
ALARM_TEST_KEY=

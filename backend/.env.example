# Bu dosyayı .env adıyla kopyalayıp gerçek değerleri yazın.
# .env dosyası Git'e yüklenmez, şifreler orada güvende kalır.

# Yerel geliştirme: SSH tüneli açıkken sunucudaki bilet_dev veritabanına bağlanır.
DATABASE_URL=postgresql+psycopg://KULLANICI:SIFRE@localhost:5433/bilet_dev

# Frontend adresleri (virgülle ayrılmış)
CORS_ORIGINS=http://localhost:3000
